# Puerto del servidor (Render lo asigna automáticamente en producción)
PORT=3000

# ID privado del propietario en Telegram (Solo este usuario puede interactuar con el bot)
TELEGRAM_ADMIN_CHAT_ID=9297971350

# Token completo de tu Bot creado con @BotFather (Ej: 9297971350:AAH...)
TELEGRAM_BOT_TOKEN=tu_token_completo_de_botfather_aqui

# Modo privado estricto (Bloquea el bot a cualquier persona que no sea TELEGRAM_ADMIN_CHAT_ID)
BOT_PRIVATE_MODE=true

# Clave secreta de administrador para desbloquear el panel web
ADMIN_SECRET_KEY=9297971350

# Modo de ejecución del Bot (independiente vs web):
# Pon ENABLE_WEB_BOT=false si ejecutas el bot aparte con "npm run bot"
ENABLE_WEB_BOT=true
# TELEGRAM_MODE=polling (opcional) o TELEGRAM_WEBHOOK_URL=https://tu-web.onrender.com
# FGC_WEB_URL=https://fgc-vault.onrender.com (opcional para sincronizar bot.js con la web remota)

# Base de datos en la nube opcional (Supabase REST o Webhook bidireccional)
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_KEY=tu_service_role_o_anon_key
# CLOUD_SYNC_URL=https://tu-endpoint-json-sync

# CDN externo opcional para animaciones (Cloudflare R2 / S3 / Cloudinary)
# ANIM_CDN_BASE_URL=https://cdn.tudominio.com/animaciones-personajes

# APIs opcionales para torneos en vivo y canal de YouTube
# STARTGG_API_KEY=tu_token_startgg
# YOUTUBE_API_KEY=tu_api_key_youtube
# YOUTUBE_CHANNEL_ID=tu_channel_id
